# Copy this file to .env and fill in your values

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/tick8
FRONTEND_ORIGIN=http://localhost:5173

# Generate a strong secret key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production

# Email (set SMTP_ENABLED=true and fill SMTP_* to send real emails)
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=yourpassword
EMAILS_FROM_EMAIL=noreply@tick8.app
EMAILS_FROM_NAME=Tick 8 Platform
